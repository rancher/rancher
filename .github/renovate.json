{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": [
    "main",
    "release/v2.15",
    "release/v2.14",
    "release/v2.13",
    "release/v2.12",
    "release/v2.11"
  ],
  "ignoreDeps": [
    "go.qase.io/client"
  ],
  "prHourlyLimit": 6,
  "prConcurrentLimit": 20,
  "packageRules": [
    {
      "matchBaseBranches": [
        "main"
      ],
      "extends": [
        "github>rancher/renovate-config//rancher-main#main"
      ]
    },
    {
      "matchBaseBranches": [
        "release/v2.15"
      ],
      "extends": [
        "github>rancher/renovate-config//rancher-2.15#main"
      ]
    },
    {
      "matchBaseBranches": [
        "release/v2.14"
      ],
      "extends": [
        "github>rancher/renovate-config//rancher-2.14#main"
      ]
    },
    {
      "matchBaseBranches": [
        "release/v2.13"
      ],
      "extends": [
        "github>rancher/renovate-config//rancher-2.13#main"
      ]
    },
    {
      "matchBaseBranches": [
        "release/v2.12"
      ],
      "extends": [
        "github>rancher/renovate-config//rancher-2.12#main"
      ]
    },
    {
      "matchBaseBranches": [
        "release/v2.11"
      ],
      "extends": [
        "github>rancher/renovate-config//rancher-2.11#main"
      ]
    },
    {
      "description": "Activate automerge for eligible updates",
      "matchBaseBranches": [
        "main",
        "release/v2.15",
        "release/v2.14",
        "release/v2.13",
        "release/v2.12",
        "release/v2.11"
      ],
      "extends": [
        "github>rancher/renovate-config//automerge#main"
      ]
    }
  ]
}
