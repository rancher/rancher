#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

ARCH=${ARCH:-"amd64"}
CHART_REPO_DIR=build/charts

build_file="$(git rev-parse --show-toplevel)/build.yaml"
# Print the value of a top-level key in build.yaml.
build_yaml_get() {
  grep -m1 "^$1:" "$build_file" | cut -d ' ' -f2
}
CHART_DEFAULT_BRANCH=${CHART_DEFAULT_BRANCH:-$(build_yaml_get chartDefaultBranch)}

# Empty when REGISTRY is unset, otherwise REGISTRY with exactly one trailing slash.
REGISTRY_PREFIX=${REGISTRY:+${REGISTRY%/}/}
IMAGE=${REGISTRY_PREFIX}${REPO}/rancher:${TAG}
AGENT_IMAGE=${REPO}/rancher-agent:${AGENT_TAG}
SYSTEM_AGENT_UPGRADE_IMAGE=${REPO}/system-agent:$(build_yaml_get systemAgentVersion)-suc
WINS_AGENT_UPGRADE_IMAGE=${REPO}/wins:$(build_yaml_get winsAgentVersion)
CLUSTER_API_CONTROLLER_IMAGE=$(build_yaml_get clusterApiControllerImage)
