#!/usr/bin/env bash

set -ex

echo "-- chart/validate --"

# Check for helm
if [ -z "$(type -p helm)" ]; then
    echo "helm not found. Helm is required to run tests."
    exit 1
fi

chart_yaml=$(dirname $0)/../../build/chart/rancher/Chart.yaml
# Build-time placeholders: 0.0.0-VERSION and %NAME% tags
placeholders='0\.0\.0-VERSION\|%[A-Z_]*%'
if grep -q "${placeholders}" "${chart_yaml}"; then
    echo "unreplaced placeholders in ${chart_yaml}:"
    grep "${placeholders}" "${chart_yaml}"
    exit 1
fi

helm lint $(dirname $0)/../../build/chart/rancher
