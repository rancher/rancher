#!/bin/bash
set -e

# Regenerates only the files derived from build.yaml (the first go:generate
# directive in generate.go). Safe to call from any directory.
cd "$(dirname "$0")/.."

echo "Generating Rancher's build.yaml values controlled files/content..."

echo "Chart Dir: $CHART_DIR"
echo "Flavor: ${RANCHER_VERSION_TYPE:-default}"

go run ./pkg/codegen/buildconfig
