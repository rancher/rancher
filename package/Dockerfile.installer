FROM --platform=$BUILDPLATFORM registry.suse.com/bci/bci-base:15.7 AS build

# Used for Helm unit testing.
RUN zypper in -y findutils git

# ARCH is needed in the Helm scripts for tests.
ARG TARGETARCH
ARG VERSION
ENV ARCH=${TARGETARCH} CHART_VERSION=${VERSION}

RUN zypper ar -f https://rpm.rancher.io/pkgs/prime pkgs && \
    rpm --import https://raw.githubusercontent.com/rancher/rancher/refs/heads/main/rancher-rpm-pkgs.key && \
    zypper in -y -r pkgs helm4 yq && \
    ln -s /usr/bin/helm4 /usr/bin/helm

# helm-unittest pinned to git commit sha of version v1.1.2
# It is needed in the Helm scripts for tests.
ENV HELM_UNITTEST_GIT_COMMIT_SHA=33c48cac798e465deda9a66c8e6c07c0973cf53d
RUN helm plugin install https://github.com/helm-unittest/helm-unittest.git --version "${HELM_UNITTEST_GIT_COMMIT_SHA}" --verify=false

WORKDIR /src
COPY .git/ /src/.git/
COPY chart/ /src/chart/
COPY scripts/ /src/scripts/
COPY build.yaml .

RUN /src/scripts/export-config
RUN /src/scripts/chart/ci

FROM scratch
COPY --from=build /usr/bin/helm /helm
COPY --from=build /src/bin/chart/*/*.tgz /
COPY package/installer-run.sh /run.sh
