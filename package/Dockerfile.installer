FROM --platform=$BUILDPLATFORM registry.suse.com/bci/bci-base:16.0 AS build

RUN zypper in -y wget git

# All downloaded binaries are used at the build layer only,
# therefore they can be based off the BUILD PLATFORM architecture.
ARG BUILDARCH

ARG VERSION
ENV CHART_VERSION=${VERSION}

# set up helm 4
# renovate: datasource=github-release-attachments depName=helm/helm
ENV HELM_VERSION=v4.3.0
ENV HELM_CHECKSUM_amd64=86584a54def73570558f66f5111cc53dfed56689637ae32c1201205d494f54fb
ENV HELM_CHECKSUM_arm64=31c5794dd55c66a51e6b7d2e2ac7a114ae8b1de41ff1d9ba51748ac973b06a08

RUN if [ "${BUILDARCH}" = "amd64" ]; then \
        HELM_CHECKSUM="${HELM_CHECKSUM_amd64}"; \
    elif [ "${BUILDARCH}" = "arm64" ]; then \
        HELM_CHECKSUM="${HELM_CHECKSUM_arm64}"; \
    fi; \
    wget "https://get.helm.sh/helm-${HELM_VERSION}-linux-${BUILDARCH}.tar.gz" -O /tmp/helm.tar.gz && \
    echo "${HELM_CHECKSUM}  /tmp/helm.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/helm.tar.gz --strip-components=1 -C /usr/bin && \
    chown root:root /usr/bin/helm && \
    chmod +x /usr/bin/helm && \
    rm -f /tmp/helm.tar.gz

# renovate: datasource=github-release-attachments depName=mikefarah/yq
ENV YQ_VERSION=v4.53.6
ENV YQ_CHECKSUM_amd64=38b907b21b1b04327fb9481c595331d925a67c6ee1aabd0ef419d0b7d12dfb3d
ENV YQ_CHECKSUM_arm64=d5e7531273d45c5d4b7abb4a1597c47a0fecb5d6b081dfa755064b38ffcc34f4

RUN if [ "${BUILDARCH}" = "amd64" ]; then \
        YQ_CHECKSUM="${YQ_CHECKSUM_amd64}"; \
    elif [ "${BUILDARCH}" = "arm64" ]; then \
        YQ_CHECKSUM="${YQ_CHECKSUM_arm64}"; \
    fi; \
    wget -q https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_${BUILDARCH}.tar.gz -O /tmp/yq.tar.gz && \
    echo "${YQ_CHECKSUM}  /tmp/yq.tar.gz" | sha256sum -c - && \
    tar xzf /tmp/yq.tar.gz && mv yq_linux_${BUILDARCH} /usr/bin/yq && \
    rm -f /tmp/yq.tar.gz

WORKDIR /src
COPY .git/ /src/.git/
COPY chart/ /src/chart/
COPY scripts/ /src/scripts/
COPY build.yaml .

RUN /src/scripts/chart/ci

FROM scratch
COPY --from=build /usr/bin/helm /helm
COPY --from=build /src/bin/chart/*/*.tgz /
COPY package/installer-run.sh /run.sh
